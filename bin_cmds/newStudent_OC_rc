echo "Entrer le contact whatsapp de l'élève: "
read whatsapp
if [ "$whatsapp" == "" ];then whatsapp="???";fi
sed -i -e "s/whatsapp/${whatsapp}/g" README.md

echo "Entrer les outils de visio privilégié avec l'élève: "
declare -a visioTool=(OC Gmeet WhatsApp)
read visioTool_
sed -i -e "s/visioTool/$(echo "${visioTool[@]}") $(echo "${visioTool_}")/g" README.md







